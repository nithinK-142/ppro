global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  - job_name: padosipro-api
    metrics_path: /metrics
    scrape_timeout: 5s
    authorization:
      type: Bearer
      credentials: '__METRICS_TOKEN__'
    static_configs:
      - targets: ['__PROMETHEUS_API_TARGET__']
