{
  "expo": {
    "name": "PadosiPro",
    "slug": "padosipro",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "padosipro",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F2EA",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#F5F2EA"
        }
      ]
    ],
    "android": {
      "package": "com.nithink.padosipro"
    },
    "ios": {
      "bundleIdentifier": "com.nithink.padosipro"
    },
    "icon": "./assets/icon.png"
  }
}
