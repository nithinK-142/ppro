NODE_ENV=development
PORT=4000
DATABASE_PATH=./data/padosipro.db
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
OTP_SECRET=replace-with-another-long-random-secret
OTP_EXPIRES_MINUTES=10
OTP_RESEND_SECONDS=30
OTP_MAX_ATTEMPTS=5
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PadosiPro <no-reply@padosipro.local>
CLIENT_ORIGIN=http://localhost:8081
TRUST_PROXY=false
LOG_LEVEL=info
