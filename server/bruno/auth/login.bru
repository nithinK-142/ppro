meta {
  name: Auth - Login
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  const body = res.getBody();
  const accessToken = body?.data?.accessToken || body?.data?.token;
  if (accessToken) bru.setVar("token", accessToken);
  if (body?.data?.refreshToken) bru.setVar("refreshToken", body.data.refreshToken);
}
