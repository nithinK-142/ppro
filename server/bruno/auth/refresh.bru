meta {
  name: Auth - Refresh tokens
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/v1/auth/refresh
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

script:post-response {
  const body = res.getBody();
  if (body?.data?.accessToken) bru.setVar("token", body.data.accessToken);
  if (body?.data?.refreshToken) bru.setVar("refreshToken", body.data.refreshToken);
}
