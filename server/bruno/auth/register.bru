meta {
  name: Auth - Register
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}",
    "confirmPassword": "{{confirmPassword}}"
  }
}
