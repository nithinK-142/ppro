# Test-only settings. Use a disposable PostgreSQL database; tests clear and reseed tables.

# App
NODE_ENV=test
PORT=4000
CLIENT_ORIGIN=http://localhost:8081
TRUST_PROXY=false

# Logging
LOG_LEVEL=silent

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/padosipro_test
DATABASE_POOL_MAX=5
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_CONNECTION_TIMEOUT_MS=10000

# Authentication
JWT_SECRET=test-jwt-secret-abcdefghijklmnopqrstuvwxyz
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

# OTP
OTP_SECRET=test-otp-secret-abcdefghijklmnopqrstuvwxyz
OTP_EXPIRES_MINUTES=10
OTP_RESEND_SECONDS=30
OTP_MAX_ATTEMPTS=5

# Mail
MAILJET_API_KEY=test-mailjet-api-key
MAILJET_SECRET_KEY=test-mailjet-secret-key
MAILJET_SEND_URL=https://mail.example.test/send
MAILJET_TIMEOUT_MS=1000
MAIL_FROM_EMAIL=noreply@example.test
MAIL_FROM_NAME=PadosiPro Tests